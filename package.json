{
  "name": "threadlands",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dev": "node build.mjs --watch & electron .",
    "typecheck": "tsc --noEmit",
    "spike": "tsx spike/phase0.ts",
    "usage": "tsx spike/usage-probe.ts",
    "selftest": "npm run build && THREADLANDS_SELFTEST=./selftest electron .",
    "assets": "python3 tools/prep_assets.py",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "main": "dist/main.js",
  "productName": "Threadlands",
  "build": {
    "appId": "com.hatfieldmedia.threadlands",
    "productName": "Threadlands",
    "icon": "build/icon.icns",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
